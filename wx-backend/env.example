# 服务配置
PORT=3000
NODE_ENV=development

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mall_db
DB_USER=root
DB_PASSWORD=

# JWT配置
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# 微信小程序配置
WECHAT_APPID=your_wechat_mini_program_appid
WECHAT_SECRET=your_wechat_mini_program_secret
WECHAT_H5_APPID=your_wechat_h5_or_open_platform_appid
WECHAT_H5_SECRET=your_wechat_h5_or_open_platform_secret

# 微信支付配置
WECHAT_PAY_MCHID=your_wechat_pay_merchant_id
WECHAT_PAY_PRIVATE_KEY_PATH=./certs/wechat_pay_private_key.pem
WECHAT_PAY_CERT_SERIAL_NO=your_wechat_pay_cert_serial_number
WECHAT_PAY_APIV3_KEY=your_wechat_pay_apiv3_key
WECHAT_PAY_NOTIFY_URL=https://yourdomain.com/api/payments/callback/wechat
REFERRAL_LANDING_URL=https://jxxcfwlkj.cn/referral-jump.html
PUBLIC_API_BASE=https://jxxcfwlkj.cn/api
PUBLIC_WEB_BASE=https://jxxcfwlkj.cn

# 支付宝支付配置（已停用，保留占位说明）
# 当前项目运行于微信小程序环境，不支持支付宝支付

# 6jqb 聚合支付配置（微信小程序）
JQB_PAY_BASE_URL=https://pay.prod.6jqb.com
JQB_PAY_MCH_NO=your_mch_no
JQB_PAY_APP_ID=your_app_id
JQB_PAY_KEY=your_md5_key
JQB_PAY_WAY_CODE=WX_LITE
# 使用自己小程序 openid 的特约商户通常需要开启
JQB_PAY_IS_SUB_OPENID=false
# 调试开关：打印 6jqb 请求/回参，生产建议关闭
JQB_PAY_DEBUG=false
# 是否严格校验统一下单/查单同步返回的 sign。
# 建议默认 false，真正支付结果仍以异步回调 notify 验签为准。
JQB_PAY_STRICT_RESPONSE_SIGN=false
# 不配置则自动使用 PUBLIC_API_BASE + /payments/notify
JQB_PAY_NOTIFY_URL=https://yourdomain.com/api/payments/notify
# 不配置则自动使用 PUBLIC_WEB_BASE + /pay-return.html
JQB_PAY_RETURN_URL=https://yourdomain.com/pay-return.html

# 支付通道开关（兼容两套：wechat / wxpay）
# PAY_DEFAULT_METHOD：当客户端未传 paymentMethod 时使用
PAY_DEFAULT_METHOD=wxpay
# PAY_FORCE_METHOD：强制使用指定通道（用于灰度/回滚），留空表示不强制
# PAY_FORCE_METHOD=wxpay

# 文件上传配置
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# 第三方通知配置
THIRD_PARTY_NOTIFY_URL=https://third-party-platform.com/api/notify

# Redis配置 (可选，用于缓存)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 日志配置
LOG_LEVEL=info
LOG_FILE_PATH=./logs
