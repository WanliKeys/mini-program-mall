# 生产环境配置
NODE_ENV=production

# 服务端口配置
BACKEND_PORT=3000
ADMIN_PORT=3001

# 数据库配置
DB_HOST=mysql
DB_PORT=3306
DB_NAME=mall_db
DB_USER=mall_user
DB_PASSWORD=your_secure_db_password_here
MYSQL_ROOT_PASSWORD=your_secure_root_password_here

# Redis配置
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT配置
JWT_SECRET=your_very_secure_jwt_secret_key_at_least_32_chars_long
JWT_EXPIRES_IN=7d

# 微信小程序配置 (请替换为你的实际配置)
WECHAT_APPID=your_wechat_appid_here
WECHAT_SECRET=your_wechat_secret_here

# 微信支付配置 (请替换为你的实际配置)
WECHAT_PAY_MCHID=your_merchant_id_here
WECHAT_PAY_PRIVATE_KEY_PATH=./certs/apiclient_key.pem
WECHAT_PAY_CERT_SERIAL_NO=your_cert_serial_no_here
WECHAT_PAY_APIV3_KEY=your_api_v3_key_here
WECHAT_PAY_NOTIFY_URL=https://your-domain.com/api/payments/callback/wechat

# 文件上传配置
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# 前端域名配置
FRONTEND_URL=https://your-domain.com

# 微信支付配置 - 生产环境使用真实支付
WECHAT_PAY_MOCK=false

# 日志配置
LOG_LEVEL=info
LOG_FILE_PATH=./logs

# 第三方通知配置 (可选)
THIRD_PARTY_NOTIFY_URL=https://your-third-party-domain.com/api/notify