# 微信支付测试配置示例
# 请复制此文件为 .env 并填入真实值

# 服务配置
PORT=3000
NODE_ENV=development

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mall_db
DB_USER=root
DB_PASSWORD=

# JWT配置
JWT_SECRET=your_super_secret_jwt_key_here_change_this_in_production
JWT_EXPIRES_IN=7d

# 微信小程序配置（从微信公众平台获取）
WECHAT_APPID=wx1234567890abcdef
WECHAT_SECRET=your_wechat_mini_program_secret

# 微信支付配置（从微信支付商户平台获取）
WECHAT_PAY_MCHID=1234567890
WECHAT_PAY_PRIVATE_KEY_PATH=./certs/wechat_pay_private_key.pem
WECHAT_PAY_CERT_SERIAL_NO=your_cert_serial_number
WECHAT_PAY_APIV3_KEY=your_apiv3_key_32_chars_long
WECHAT_PAY_NOTIFY_URL=http://localhost:3000/api/payments/callback/wechat

# 文件上传配置
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# 第三方通知配置
THIRD_PARTY_NOTIFY_URL=https://third-party-platform.com/api/notify

# 日志配置
LOG_LEVEL=info
LOG_FILE_PATH=./logs
